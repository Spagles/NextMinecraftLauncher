<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NML.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Shared design tokens (dark theme) -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#0a0a0e"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1a1a1e"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#1f1f25"/>
            <SolidColorBrush x:Key="PanelAltBrush" Color="#25252b"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#e0e0e0"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#aaa"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#666"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#4fc3f7"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#4caf50"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#f44336"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Unified button styles (defined once, used everywhere) -->
        <StyleInclude Source="avares://NML.App/Styles/Theme.axaml"/>
        <Style Selector="Window">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titleBtnClose /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
