<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>NML.App — desktop entry point (Windows / macOS / Linux). Hosts Avalonia UI + DI container.</Description>

    <!-- Single-file self-contained publish (HMCL/PCL-style: one NML.App.exe, no other files).
         Self-contained so users don't need the .NET 8 runtime installed; native libs + managed
         assemblies are bundled into the exe and extracted to a temp dir at run time.
         The RID is NOT pinned here — pass -r at publish time to target a platform:
           dotnet publish -c Release -r win-x64   (Windows)
           dotnet publish -c Release -r linux-x64 (Linux)
           dotnet publish -c Release -r osx-x64   (macOS Intel) / osx-arm64 (Apple Silicon) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NML.Core\NML.Core.csproj" />
    <ProjectReference Include="..\NML.Data\NML.Data.csproj" />
    <ProjectReference Include="..\NML.AICore\NML.AICore.csproj" />
  </ItemGroup>

  <!-- Embedded i18n resource files -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

</Project>
