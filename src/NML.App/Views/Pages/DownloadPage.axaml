<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.DownloadPage" x:Name="Root">
    <DockPanel LastChildFill="True">
        <!-- Search + filter bar -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="24,16,24,8">
            <TextBox Text="{Binding SearchText}" Watermark="{loc:Loc 'download.search_placeholder'}" MinWidth="400"/>
            <!-- Install progress bar (visible only when installing) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsInstalling}">
                <TextBlock Text="{Binding InstallingVersion}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                <ProgressBar Value="{Binding InstallProgress}" Maximum="100" MinHeight="4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{loc:Loc 'download.filter_all'}"      Click="SelectFilter" Tag="all" Classes="tabbtn"/>
                <Button Content="{loc:Loc 'download.filter_release'}"  Click="SelectFilter" Tag="release" Classes="tabbtn"/>
                <Button Content="{loc:Loc 'download.filter_snapshot'}" Click="SelectFilter" Tag="snapshot" Classes="tabbtn"/>
                <Button Content="{loc:Loc 'download.filter_old'}"      Click="SelectFilter" Tag="old_beta" Classes="tabbtn"/>
            </StackPanel>
            <Button Content="{loc:Loc 'common.refresh'}" Command="{Binding LoadCommand}" HorizontalAlignment="Left"
                    IsEnabled="{Binding !IsLoading}"/>
            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" Margin="0,4"/>
        </StackPanel>

        <!-- Modloader install panel (HMCL-style: install Fabric/Forge/Quilt/NeoForge against a version) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="16,12" Margin="24,4,24,8">
            <StackPanel Spacing="8">
                <TextBlock Text="🧩 Install Modloader" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Game version:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding FilteredVersions}" SelectedItem="{Binding SelectedModloaderVersion}"
                              MinWidth="220" MaxDropDownHeight="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Id}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Loader:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ModloaderChoices}" SelectedItem="{Binding SelectedModloader}" MinWidth="120"/>
                    <Button Content="Install" Command="{Binding InstallModloaderCommand}" Classes="small"
                            IsEnabled="{Binding !IsInstalling}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           IsVisible="{Binding IsInstalling}"/>
            </StackPanel>
        </Border>

        <!-- Version list -->
        <ScrollViewer Padding="24,0,24,24">
            <ItemsControl ItemsSource="{Binding FilteredVersions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="14,10" Margin="0,2">
                            <Grid ColumnDefinitions="*,120,120,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ReleaseTime, StringFormat=\{0:yyyy-MM-dd\}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="{loc:Loc 'download.install'}" Classes="small"
                                        Command="{Binding #Root.DataContext.InstallCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="Button.tabbtn"><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
</UserControl>
