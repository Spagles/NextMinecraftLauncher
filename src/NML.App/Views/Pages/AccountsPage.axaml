<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             xmlns:ctl="using:NML.App.Views.Controls"
             x:Class="NML.App.Views.Pages.AccountsPage" x:Name="Root">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <!-- Active account skin preview -->
            <Border Background="#1f1f25" CornerRadius="8" Padding="16" IsVisible="{Binding HasActiveAccount}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <!-- Draggable 3D skin cube preview (drag to rotate) -->
                    <ctl:SkinPreviewControl SkinPath="{Binding ActiveSkinPngPath}" Width="90" Height="120"/>
                    <!-- 3D head render (static fallback) -->
                    <Image Source="{Binding ActiveHeadRenderUrl}" Width="64" Height="64" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding ActiveAccount.Username}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <Image Source="{Binding ActiveAvatarUrl}" Width="32" Height="32"/>
                        <TextBlock Text="{Binding ActiveAccount.Uuid}" Foreground="#888" FontSize="10"/>
                        <TextBlock Text="🖱️ drag the model to rotate" Foreground="#666" FontSize="10" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Add account -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding NewOfflineUsername}" Watermark="{loc:Loc 'accounts.username'}" MinWidth="180"/>
                    <Button Content="{loc:Loc 'accounts.add_offline'}" Command="{Binding AddOfflineAccountCommand}"/>
                </StackPanel>
                <Button Content="{loc:Loc 'accounts.add_microsoft'}" Command="{Binding AddMicrosoftAccountCommand}"
                        IsEnabled="{Binding !IsBusy}" Background="#2f5fcc" Foreground="White" Padding="14,6"/>
            </StackPanel>

            <!-- Device code hint -->
            <Border Background="#2a2a30" Padding="12" CornerRadius="4" IsVisible="{Binding ShowDeviceCode}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding DeviceCodeMessage}" Foreground="#4fc3f7" FontSize="13"/>
                    <TextBlock Text="{loc:Loc 'accounts.ms_polling'}" Foreground="#888" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- authlib-injector (external login) server management -->
            <Border Background="#1f1f25" CornerRadius="4" Padding="14,12" Margin="0,4">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc 'accounts.authlib_servers'}" Foreground="#4fc3f7" FontSize="13" FontWeight="SemiBold"/>

                    <!-- Add a new server -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding NewServerName}" Watermark="{loc:Loc 'accounts.authlib_server_name'}" MinWidth="120"/>
                        <TextBox Text="{Binding NewServerUrl}" Watermark="{loc:Loc 'accounts.authlib_server_url'}" MinWidth="280"/>
                        <Button Content="{loc:Loc 'accounts.authlib_add_server'}" Command="{Binding AddAuthlibServerCommand}"/>
                    </StackPanel>

                    <!-- Saved servers list -->
                    <ItemsControl ItemsSource="{Binding AuthlibServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2a2a30" CornerRadius="4" Padding="10,8" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                                            <TextBlock Text="{Binding ApiUrl}" FontSize="10" Foreground="#888"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{loc:Loc 'accounts.authlib_delete_server'}" Classes="small danger"
                                                Command="{Binding #Root.DataContext.RemoveAuthlibServerCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc 'accounts.authlib_no_servers'}" Foreground="#888" FontSize="11"
                               IsVisible="{Binding !HasAuthlibServers}"/>

                    <!-- Login via selected server -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding HasAuthlibServers}">
                        <ComboBox ItemsSource="{Binding AuthlibServers}" SelectedItem="{Binding SelectedAuthlibServer}" MinWidth="160"/>
                        <TextBox Text="{Binding AuthlibLoginName}" Watermark="{loc:Loc 'accounts.authlib_login'}" MinWidth="140"/>
                        <TextBox Text="{Binding AuthlibPassword}" Watermark="{loc:Loc 'accounts.authlib_password'}" MinWidth="120" PasswordChar="•"/>
                        <Button Content="{loc:Loc 'accounts.authlib_use_server'}" Classes="small"
                                Command="{Binding LoginWithServerCommand}"
                                CommandParameter="{Binding SelectedAuthlibServer}"
                                IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Skin upload -->
            <Border Background="#1f1f25" CornerRadius="4" Padding="14,12" IsVisible="{Binding HasActiveAccount}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc 'skins.upload_title'}" Foreground="#4fc3f7" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox SelectedIndex="0" MinWidth="140">
                            <ComboBoxItem Content="{loc:Loc 'skins.model_classic'}"/>
                            <ComboBoxItem Content="{loc:Loc 'skins.model_slim'}"/>
                        </ComboBox>
                        <TextBox Text="{Binding UploadPngPath}" Watermark="skin.png" MinWidth="180"/>
                        <Button Content="{loc:Loc 'skins.upload_button'}" Command="{Binding UploadSkinCommand}"
                                IsEnabled="{Binding !IsUploadingSkin}" Classes="small"/>
                        <Button Content="{loc:Loc 'skins.reset'}" Command="{Binding ResetSkinCommand}" Classes="small"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Community skin library -->
            <Border Background="#1f1f25" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc 'skins.community_title'}" Foreground="#4fc3f7" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding CommunitySearchText}" Watermark="{loc:Loc 'skins.community_search_placeholder'}" MinWidth="220"/>
                        <Button Content="{loc:Loc 'skins.community_search'}" Command="{Binding SearchCommunityCommand}" Classes="small"/>
                        <Button Content="{loc:Loc 'skins.community_browse'}" Command="{Binding BrowseCommunityCommand}" Classes="small"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding CommunitySkins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2a2a30" CornerRadius="4" Padding="8" Margin="0,2">
                                    <Grid ColumnDefinitions="40,*,Auto">
                                        <Image Grid.Column="0" Source="{Binding PreviewUrl}" Width="32" Height="32"/>
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                            <TextBlock Text="{Binding Model}" Foreground="#888" FontSize="10"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{loc:Loc 'skins.community_install'}" Classes="small"
                                                Command="{Binding #Root.DataContext.InstallCommunitySkinCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc 'skins.community_empty'}" Foreground="#888" FontSize="11"
                               IsVisible="{Binding !HasCommunitySkins}"/>
                </StackPanel>
            </Border>

            <!-- Account list -->
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1f1f25" CornerRadius="4" Padding="14,10" Margin="0,2">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Username}" Foreground="White"/>
                                    <TextBlock Text="{Binding Uuid}" FontSize="10" Foreground="#888"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{loc:Loc 'accounts.activate'}" Classes="small" Margin="6,0"
                                        Command="{Binding #Root.DataContext.ActivateCommand}" CommandParameter="{Binding}"/>
                                <Button Grid.Column="2" Content="{loc:Loc 'accounts.remove'}" Classes="small danger"
                                        Command="{Binding #Root.DataContext.RemoveCommand}" CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.small"><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.small.danger"><Setter Property="Background" Value="#b23b3b"/><Setter Property="Foreground" Value="White"/></Style>
    </UserControl.Styles>
</UserControl>
