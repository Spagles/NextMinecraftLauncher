<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="NML.App.Views.Pages.GameContentPage" x:Name="Root">
    <DockPanel>
        <!-- Tab strip + open folder -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="24,16,24,8">
            <Button Content="{loc:Loc 'content.saves'}"          Click="SelectTab" Tag="saves" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.screenshots'}"    Click="SelectTab" Tag="screenshots" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.resource_packs'}" Click="SelectTab" Tag="resourcepacks" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.mods'}"           Click="SelectTab" Tag="mods" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.enable_all'}"     Command="{Binding EnableAllModsCommand}" Classes="small" Margin="16,0,0,0"/>
            <Button Content="{loc:Loc 'content.disable_all'}"    Command="{Binding DisableAllModsCommand}" Classes="small"/>
            <!-- One-click mod upgrade: check updates, then upgrade all flagged mods. -->
            <Button Content="{loc:Loc 'mods.upgrade.upgrade_all'}" Command="{Binding UpgradeAllModsCommand}"
                    Classes="small" Background="#388e3c" Foreground="White"
                    IsEnabled="{Binding !IsCheckingModUpdates}" Margin="8,0,0,0"/>
            <Button Content="{loc:Loc 'content.logs'}"           Click="SelectTab" Tag="logs" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.configs'}"        Click="SelectTab" Tag="configs" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.open_folder'}" Command="{Binding OpenFolderCommand}" Classes="small" Margin="16,0,0,0"/>
        </StackPanel>

        <ScrollViewer Padding="24,0,24,24">
            <StackPanel>
                <!-- File/content list (hidden on logs tab) -->
                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsFileListVisible}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12,8" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeBytes, StringFormat=\{0:N0\} B}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Loc 'content.backup'}" Classes="small"
                                            Command="{Binding #Root.DataContext.BackupWorldCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsSavesTab}" Margin="4,0"/>
                                    <Button Grid.Column="2" Content="{loc:Loc 'content.export'}" Classes="small"
                                            Command="{Binding #Root.DataContext.ExportWorldCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsSavesTab}" Margin="4,0"/>
                                    <Button Grid.Column="2" Content="{loc:Loc 'content.open'}" Classes="small"
                                            Command="{Binding #Root.DataContext.OpenScreenshotCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsScreenshotsTab}" Margin="4,0"/>
                                    <Button Grid.Column="3" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                            Command="{Binding #Root.DataContext.DeleteWorldCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsSavesTab}"/>
                                    <Button Grid.Column="3" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                            Command="{Binding #Root.DataContext.DeleteScreenshotCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsScreenshotsTab}"/>
                                    <Button Grid.Column="3" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                            Command="{Binding #Root.DataContext.DeleteResourcePackCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsResourcePacksTab}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- World grid (visible on the saves tab): icon + name + last played + one-click backup -->
                <WrapPanel IsVisible="{Binding IsSavesTab}" Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding WorldCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,0,10,10" Width="220">
                                    <StackPanel Spacing="6">
                                        <!-- Preview icon, or placeholder when the world has none -->
                                        <Grid HorizontalAlignment="Center">
                                            <Image Source="{Binding PreviewIconPath}" Width="96" Height="96"
                                                   IsVisible="{Binding HasIcon}"/>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Width="96" Height="96"
                                                    IsVisible="{Binding !HasIcon}">
                                                <TextBlock Text="🌍" FontSize="40" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold"
                                                   FontSize="13" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastPlayedDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <!-- Achievement + play-time + difficulty summary -->
                                        <StackPanel Spacing="1" Margin="0,2">
                                            <TextBlock Text="{Binding PlayTimeDisplay}" Foreground="#81c784" FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       IsVisible="{Binding PlayTimeDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding AchievementDisplay}" Foreground="#ffb74d" FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       IsVisible="{Binding AchievementDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding DifficultyDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       IsVisible="{Binding DifficultyDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <!-- World seed display + copy button -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                                    IsVisible="{Binding SeedDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Seed:" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                            <SelectableTextBlock Text="{Binding SeedDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="10"
                                                                  FontFamily="Cascadia Code,Consolas,monospace" VerticalAlignment="Center"/>
                                            <Button Content="📋" Command="{Binding #Root.DataContext.CopySeedCommand}"
                                                    CommandParameter="{Binding}" Padding="4,2" FontSize="9"/>
                                            <Button Content="🗺" Command="{Binding #Root.DataContext.OpenSeedOnlineCommand}"
                                                    CommandParameter="{Binding}" Padding="4,2" FontSize="9"
                                                    ToolTip.Tip="View seed online (Chunk Base biome map)"/>
                                        </StackPanel>
                                        <!-- One-click backup is the primary action; export/delete as secondary -->
                                        <Button Content="{loc:Loc 'world.quick_backup'}" Classes="small"
                                                Command="{Binding #Root.DataContext.BackupWorldCardCommand}"
                                                CommandParameter="{Binding}"
                                                Background="#388e3c" Foreground="White" HorizontalAlignment="Stretch"
                                                Margin="0,2"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Button Content="{loc:Loc 'content.export'}" Classes="small"
                                                    Command="{Binding #Root.DataContext.ExportWorldCardCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                                    Command="{Binding #Root.DataContext.DeleteWorldCardCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <Button Content="📊 Details" Classes="small" HorizontalAlignment="Center" Margin="0,2"
                                                Command="{Binding #Root.DataContext.ToggleWorldDetailsCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding StatLines, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <Button Content="📥 Export CSV" Classes="small" HorizontalAlignment="Center" Margin="0,2"
                                                Command="{Binding #Root.DataContext.ExportWorldStatsCsvCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding StatLines, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <ItemsControl ItemsSource="{Binding StatLines}" IsVisible="{Binding ShowDetails}" Margin="0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Completed achievements -->
                                        <ItemsControl ItemsSource="{Binding AchievementLines}" IsVisible="{Binding ShowDetails}" Margin="0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#81c784" FontSize="9" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Edit world settings (difficulty + gamerules) — HMCL-style edit-without-launch -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8"
                                                IsVisible="{Binding ShowDetails}" Margin="0,6,0,0">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="⚙️ World Settings" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <!-- Rename world: LevelName edit + folder rename -->
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <TextBox Text="{Binding EditableName}" MinWidth="120" FontSize="10"/>
                                                    <Button Content="Rename" Classes="small" FontSize="10"
                                                            Command="{Binding #Root.DataContext.RenameWorldCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Difficulty:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                    <ComboBox SelectedItem="{Binding EditableDifficulty}" MinWidth="90" FontSize="10">
                                                        <sys:String>peaceful</sys:String>
                                                        <sys:String>easy</sys:String>
                                                        <sys:String>normal</sys:String>
                                                        <sys:String>hard</sys:String>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Game Mode:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                    <ComboBox SelectedItem="{Binding EditableGameType}" MinWidth="100" FontSize="10">
                                                        <sys:String>survival</sys:String>
                                                        <sys:String>creative</sys:String>
                                                        <sys:String>adventure</sys:String>
                                                        <sys:String>spectator</sys:String>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                                    <CheckBox Content="keepInv" IsChecked="{Binding EditableKeepInventory}" FontSize="10"/>
                                                    <CheckBox Content="mobs" IsChecked="{Binding EditableMobSpawning}" FontSize="10"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                                    <CheckBox Content="fireTick" IsChecked="{Binding EditableFireTick}" FontSize="10"/>
                                                    <CheckBox Content="griefing" IsChecked="{Binding EditableMobGriefing}" FontSize="10"/>
                                                </StackPanel>
                                                <Button Content="✅ Apply" Classes="small" HorizontalAlignment="Center"
                                                        Command="{Binding #Root.DataContext.ApplyWorldSettingsCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- Backups panel (visible on the saves tab): list + restore / delete per row -->
                <StackPanel IsVisible="{Binding IsSavesTab}" Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="{loc:Loc 'backup.title'}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc 'backup.empty'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontStyle="Italic"
                               IsVisible="{Binding Backups.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>
                    <ItemsControl ItemsSource="{Binding Backups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="10,6" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding WorldName}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding DateDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                                <TextBlock Text="{Binding SizeDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{loc:Loc 'backup.restore'}" Classes="small"
                                                Command="{Binding #Root.DataContext.RestoreBackupCommand}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding !#Root.DataContext.IsRestoring}"
                                                Background="#388e3c" Foreground="White" Margin="6,0"/>
                                        <Button Grid.Column="2" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                                Command="{Binding #Root.DataContext.DeleteBackupCommand}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding !#Root.DataContext.IsRestoring}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Restore progress + cancel (shown only while a restore is in flight) -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsRestoring}" Margin="0,4">
                        <ProgressBar Value="{Binding RestoreProgress}" Maximum="100" Minimum="0" MinWidth="300"/>
                        <Button Content="{loc:Loc 'backup.restore.cancel'}" Command="{Binding CancelRestoreCommand}"
                                Classes="small danger" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <!-- Screenshot grid (visible on the screenshots tab): thumbnail cards + multi-select + batch export -->
                <StackPanel IsVisible="{Binding IsScreenshotsTab}" Spacing="8" Margin="0,4">
                    <!-- Batch toolbar: select-all toggle + export-selected -->
                    <WrapPanel>
                        <CheckBox Content="{loc:Loc 'screenshot.select_all'}" IsChecked="{Binding AllScreenshotsSelected}"
                                  Command="{Binding SelectAllScreenshotsCommand}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Content="{loc:Loc 'screenshot.export_selected'}"
                                Command="{Binding ExportSelectedScreenshotsCommand}"
                                IsEnabled="{Binding HasScreenshotSelection}"
                                Background="{DynamicResource AccentBrush}" Foreground="White" Padding="14,5" Margin="8,0"/>
                        <TextBlock Text="{loc:Loc 'screenshot.hint'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" FontStyle="Italic"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding ScreenshotCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="8" Margin="0,0,8,8" Width="220">
                                    <StackPanel Spacing="4">
                                        <!-- Thumbnail bound directly to the on-disk PNG path -->
                                        <Image Source="{Binding Path}" Width="200" Height="112" Stretch="UniformToFill"
                                               ClipToBounds="True" HorizontalAlignment="Center"/>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Command="{Binding #Root.DataContext.ToggleScreenshotCommand}"
                                                  CommandParameter="{Binding}" Foreground="White" FontSize="11"/>
                                        <TextBlock Text="{Binding DateDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Button Content="{loc:Loc 'content.open'}" Classes="small" Margin="0,0,4,0"
                                                    Command="{Binding #Root.DataContext.OpenScreenshotCardCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{loc:Loc 'screenshot.copy'}" Classes="small" Margin="0,0,4,0"
                                                    Command="{Binding #Root.DataContext.CopyScreenshotCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                                    Command="{Binding #Root.DataContext.DeleteScreenshotCardCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Timeline browse: screenshots grouped by date (Today / Yesterday / yyyy-MM-dd) -->
                    <ItemsControl ItemsSource="{Binding ScreenshotGroups}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="4" Margin="0,0,6,6" Width="160">
                                                        <StackPanel Spacing="2">
                                                            <Image Source="{Binding Path}" Width="150" Height="84" Stretch="UniformToFill" ClipToBounds="True" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="150" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Resource-pack preview cards (icon + description + pack_format) -->
                <WrapPanel IsVisible="{Binding IsResourcePacksTab}" Orientation="Horizontal" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding ResourcePackCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,0,10,10" Width="240">
                                    <StackPanel Spacing="6">
                                        <Image Source="{Binding IconPath}" Width="64" Height="64"
                                               IsVisible="{Binding HasIcon}" HorizontalAlignment="Center"/>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Width="64" Height="64"
                                                IsVisible="{Binding !HasIcon}">
                                            <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
                                        <TextBlock Text="{Binding FormatDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <Button Content="{Binding ToggleLabel}"
                                                Command="{Binding #Root.DataContext.ToggleResourcePackCommand}"
                                                CommandParameter="{Binding}"
                                                Background="{DynamicResource AccentBrush}" Foreground="White" Padding="10,3"
                                                HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11"/>
                                        <Button Content="📂 Browse contents"
                                                Command="{Binding #Root.DataContext.BrowseResourcePackContentsCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="small" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="11"/>
                                        <!-- Expandable content summary + category list -->
                                        <StackPanel IsVisible="{Binding ShowContents}" Spacing="2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ContentSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                            <ItemsControl ItemsSource="{Binding ContentCategories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,1">
                                                            <Run Text="{Binding Category}"/>
                                                            <Run Text=" (" />
                                                            <Run Text="{Binding FileCount}"/>
                                                            <Run Text=" files)" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <TextBlock Text="{loc:Loc 'content.empty'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12"
                           IsVisible="{Binding IsEmpty}"/>

                <!-- Import world row (visible on saves tab) -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8"
                            IsVisible="{Binding IsSavesTab}">
                    <TextBox Text="{Binding ImportWorldPath}" Watermark="{loc:Loc 'content.import_world_placeholder'}" MinWidth="300" FontSize="11"/>
                    <Button Content="{loc:Loc 'content.import_world'}" Classes="small"
                            Command="{Binding ImportWorldCommand}"
                            CommandParameter="{Binding ImportWorldPath}"/>
                </StackPanel>

                <!-- Log viewer (visible on the logs tab) -->
                <StackPanel IsVisible="{Binding IsLogsTab}" Spacing="8" Margin="0,12,0,0">
                    <!-- Filter toolbar: search box + regex toggle + severity dropdown + refresh -->
                    <WrapPanel>
                        <TextBox Text="{Binding LogSearchText}" Watermark="{loc:Loc 'content.log_search'}" MinWidth="280"/>
                        <CheckBox Content="{loc:Loc 'log.regex'}" IsChecked="{Binding IsRegexSearch}"
                                  VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc 'log.level'}" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox ItemsSource="{Binding LogSeverityOptions}" SelectedItem="{Binding MinSeverity}"
                                  MinWidth="90"/>
                        <Button Content="{loc:Loc 'common.refresh'}" Command="{Binding LoadLogCommand}" Classes="small"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:Loc 'log.regex_hint'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontStyle="Italic"
                               IsVisible="{Binding IsRegexSearch}"/>
                    <!-- Colored, per-line log list: severity-driven Foreground on each line. -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8" MaxHeight="500">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FilteredLogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                                   FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Config editor (visible on the configs tab) -->
                <StackPanel IsVisible="{Binding IsConfigsTab}" Spacing="8" Margin="0,12,0,0">
                    <!-- File list with select buttons -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Classes="small"
                                        Command="{Binding #Root.DataContext.SelectConfigCommand}"
                                        CommandParameter="{Binding}" Margin="0,2" HorizontalAlignment="Left"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Structured per-row editor: renders key=value pairs as labeled inputs,
                         preserving comments/section headers as grayed-out text. For .cfg/.ini/.properties only. -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="8"
                            IsVisible="{Binding IsStructuredConfig}" MaxHeight="420">
                        <ScrollViewer>
                            <StackPanel Spacing="3">
                                <ItemsControl ItemsSource="{Binding ConfigEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Editable key=value row -->
                                            <Grid ColumnDefinitions="220,*,Auto" IsVisible="{Binding IsEditable}" Margin="0,1">
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="{DynamicResource AccentBrush}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBox Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Plain-text editor (TOML/JSON/unrecognized) — shown when not structured. -->
                    <TextBox Text="{Binding ConfigContent}" AcceptsReturn="True" FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="11" MinHeight="200" MaxHeight="400" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" IsVisible="{Binding !IsStructuredConfig}"/>
                    <Button Content="{loc:Loc 'common.save'}" Command="{Binding SaveConfigCommand}" Classes="small" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="Button.tabbtn"><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.small"><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.small.danger"><Setter Property="Background" Value="#b23b3b"/><Setter Property="Foreground" Value="White"/></Style>
    </UserControl.Styles>
</UserControl>
