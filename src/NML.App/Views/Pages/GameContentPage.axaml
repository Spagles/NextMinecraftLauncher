<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.GameContentPage" x:Name="Root">
    <DockPanel>
        <!-- Tab strip + open folder -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="24,16,24,8">
            <Button Content="{loc:Loc 'content.saves'}"          Click="SelectTab" Tag="saves" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.screenshots'}"    Click="SelectTab" Tag="screenshots" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.resource_packs'}" Click="SelectTab" Tag="resourcepacks" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.mods'}"           Click="SelectTab" Tag="mods" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.logs'}"           Click="SelectTab" Tag="logs" Classes="tabbtn"/>
            <Button Content="{loc:Loc 'content.open_folder'}" Command="{Binding OpenFolderCommand}" Classes="small" Margin="16,0,0,0"/>
        </StackPanel>

        <ScrollViewer Padding="24,0,24,24">
            <StackPanel>
                <!-- File/content list (hidden on logs tab) -->
                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsLogsTab}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1f1f25" CornerRadius="4" Padding="12,8" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeBytes, StringFormat=\{0:N0\} B}" Foreground="#888" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Loc 'content.backup'}" Classes="small"
                                            Command="{Binding #Root.DataContext.BackupWorldCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsSavesTab}" Margin="4,0"/>
                                    <Button Grid.Column="2" Content="{loc:Loc 'content.open'}" Classes="small"
                                            Command="{Binding #Root.DataContext.OpenScreenshotCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsScreenshotsTab}" Margin="4,0"/>
                                    <Button Grid.Column="3" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                            Command="{Binding #Root.DataContext.DeleteWorldCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsSavesTab}"/>
                                    <Button Grid.Column="3" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                            Command="{Binding #Root.DataContext.DeleteScreenshotCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsScreenshotsTab}"/>
                                    <Button Grid.Column="3" Content="{loc:Loc 'content.delete'}" Classes="small danger"
                                            Command="{Binding #Root.DataContext.DeleteResourcePackCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding #Root.DataContext.IsResourcePacksTab}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Loc 'content.empty'}" Foreground="#888" FontSize="12" Margin="0,12"
                           IsVisible="{Binding IsEmpty}"/>

                <!-- Log viewer (visible on the logs tab) -->
                <StackPanel IsVisible="{Binding IsLogsTab}" Spacing="8" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding LogSearchText}" Watermark="{loc:Loc 'content.log_search'}" MinWidth="300"/>
                        <Button Content="{loc:Loc 'common.refresh'}" Command="{Binding LoadLogCommand}" Classes="small"/>
                    </StackPanel>
                    <Border Background="#1a1a1e" CornerRadius="4" Padding="8" MaxHeight="500">
                        <ScrollViewer>
                            <SelectableTextBlock Text="{Binding FilteredLog}" Foreground="#c0c0c0"
                                                 FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                                 TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="Button.tabbtn"><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.small"><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.small.danger"><Setter Property="Background" Value="#b23b3b"/><Setter Property="Foreground" Value="White"/></Style>
    </UserControl.Styles>
</UserControl>
