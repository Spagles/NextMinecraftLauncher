<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.AssistantPage">
    <DockPanel LastChildFill="True">
        <!-- Command-block generator panel (docked at top) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="16,12" Margin="0,0,0,4">
            <StackPanel Spacing="8">
                <TextBlock Text="⚡ Command Block Generator" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold"/>
                <WrapPanel>
                    <ComboBox SelectedItem="{Binding CmdType}" MinWidth="120">
                        <ComboBoxItem Content="give"/>
                        <ComboBoxItem Content="tp"/>
                        <ComboBoxItem Content="effect"/>
                        <ComboBoxItem Content="gamemode"/>
                    </ComboBox>
                    <TextBox Text="{Binding CmdTarget}" Watermark="@p / @a / name" MinWidth="100" Margin="6,0"/>
                </WrapPanel>
                <!-- /give params -->
                <WrapPanel IsVisible="{Binding CmdType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=give}">
                    <TextBox Text="{Binding CmdItemId}" Watermark="item id" MinWidth="180" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CmdCount}" Watermark="count" MinWidth="60"/>
                </WrapPanel>
                <!-- /tp params -->
                <WrapPanel IsVisible="{Binding CmdType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=tp}">
                    <TextBox Text="{Binding CmdX}" Watermark="X" MinWidth="80" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CmdY}" Watermark="Y" MinWidth="80" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CmdZ}" Watermark="Z" MinWidth="80"/>
                </WrapPanel>
                <!-- /effect params -->
                <WrapPanel IsVisible="{Binding CmdType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=effect}">
                    <TextBox Text="{Binding CmdEffectId}" Watermark="effect id" MinWidth="140" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CmdDuration}" Watermark="seconds" MinWidth="80" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CmdAmplifier}" Watermark="amplifier" MinWidth="80"/>
                </WrapPanel>
                <!-- /gamemode params -->
                <WrapPanel IsVisible="{Binding CmdType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=gamemode}">
                    <ComboBox SelectedItem="{Binding CmdGamemode}" MinWidth="140">
                        <ComboBoxItem Content="creative"/>
                        <ComboBoxItem Content="survival"/>
                        <ComboBoxItem Content="adventure"/>
                        <ComboBoxItem Content="spectator"/>
                    </ComboBox>
                </WrapPanel>
                <!-- Generate + output -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Generate" Command="{Binding GenerateCommandCommand}"
                            Background="{DynamicResource AccentBrush}" Foreground="White" Padding="14,5"/>
                    <Button Content="📋 Copy" Command="{Binding CopyCommandCommand}" Classes="small"/>
                </StackPanel>
                <SelectableTextBlock Text="{Binding CmdOutput}" Foreground="#81c784" FontFamily="Cascadia Code,Consolas,monospace"
                                     FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CmdOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- Input bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelAltBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Input}" Watermark="{loc:Loc 'assistant.placeholder'}" MinWidth="500"
                         IsEnabled="{Binding !IsBusy}" KeyDown="Input_KeyDown"/>
                <Button Content="{loc:Loc 'assistant.send'}" Command="{Binding SendCommand}"
                        IsEnabled="{Binding !IsBusy}" Background="#4caf50" Foreground="White" Padding="18,6"/>
            </StackPanel>
        </Border>

        <!-- Conversation (auto-scrolls to bottom on new messages) -->
        <ScrollViewer x:Name="ChatScroll" Padding="24,16">
            <ItemsControl ItemsSource="{Binding Conversation}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" Padding="14,10" CornerRadius="8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Role}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                <SelectableTextBlock Text="{Binding Content}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
