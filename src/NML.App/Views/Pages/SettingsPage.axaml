<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.SettingsPage" x:Name="Root">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="22" MaxWidth="720">

            <!-- General -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc 'settings.general'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'settings.language'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="220"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'settings.theme'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" MinWidth="180"/>
                </StackPanel>
                <!-- Font size scale (HMCL feature) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Font Size" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider Minimum="0.8" Maximum="1.3" Value="{Binding FontScale}" MinWidth="200" TickFrequency="0.1"/>
                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="{Binding FontScale}"/><Run Text="×"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'settings.minecraft_path'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox Text="{Binding MinecraftPath}" MinWidth="500"/>
                </StackPanel>
                <!-- PCL-style download tuning: concurrency + mirror source -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'download.settings.title'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc 'download.settings.concurrency'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <Slider Minimum="1" Maximum="64" Value="{Binding DownloadConcurrency}" MinWidth="200" TickFrequency="4" IsSnapToTickEnabled="False"/>
                        <TextBlock Text="{Binding DownloadConcurrency}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" MinWidth="24"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc 'download.settings.mirror'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox ItemsSource="{Binding MirrorPresets}" SelectedItem="{Binding DownloadMirrorUrl}" MinWidth="280"/>
                        <TextBox Text="{Binding DownloadMirrorUrl}" Watermark="https://…" MinWidth="240" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc 'download.settings.mirror_hint'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"/>
                    <TextBlock Text="HTTP proxy" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding ProxyUrl}" Watermark="http://127.0.0.1:7890 (empty = direct)" MinWidth="280" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="Applied to all launcher downloads after restart." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'settings.background_image'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding BackgroundImagePath}" Watermark="C:\path\to\image.png" MinWidth="400"/>
                        <Button Content="{loc:Loc 'settings.background_clear'}" Click="ClearBackground_Click" Classes="small"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc 'settings.accent_color'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ItemsControl ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" CornerRadius="4" Padding="0"
                                            Background="{Binding}" Click="PickAccent_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding AccentColor}" MinWidth="100" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"/>
                    </StackPanel>
                    <!-- Live theme preview card: reflects Theme + Accent the instant either
                         changes (no restart). Every surface below binds to a Preview* property. -->
                    <Border Background="{Binding PreviewBackground}" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc 'theme.preview.title'}" Foreground="{Binding PreviewForeground}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding PreviewSampleText}" Foreground="{Binding PreviewForeground}" FontSize="11" Opacity="0.8"/>
                            <!-- Sample title bar -->
                            <Border Background="{Binding PreviewAccent}" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{loc:Loc 'theme.preview.sample_title'}" Foreground="{Binding AccentOnColor}" FontSize="11"/>
                            </Border>
                            <!-- Sample buttons + text in the chosen palette -->
                            <WrapPanel>
                                <Button Content="{loc:Loc 'theme.preview.primary'}" Background="{Binding PreviewAccent}" Foreground="{Binding AccentOnColor}" BorderThickness="0" Padding="12,4" Margin="0,0,6,0"/>
                                <Button Content="{loc:Loc 'theme.preview.secondary'}" Background="Transparent" Foreground="{Binding PreviewForeground}" BorderBrush="{Binding PreviewAccent}" BorderThickness="1" Padding="12,4"/>
                            </WrapPanel>
                            <TextBlock Text="{loc:Loc 'theme.preview.sample_body'}" Foreground="{Binding PreviewForeground}" FontSize="11" TextWrapping="Wrap" Opacity="0.85"/>
                            <!-- Invalid-accent warning surfaces only when the hex won't parse -->
                            <TextBlock Text="{loc:Loc 'theme.preview.invalid'}" Foreground="#ef5350" FontSize="11"
                                       IsVisible="{Binding !IsAccentValid}"/>
                        </StackPanel>
                    </Border>
                    <!-- Custom CSS import: paste CSS, apply to inject live, clear to remove -->
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Loc 'theme.css.title'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                        <TextBox Text="{Binding CustomCss}" AcceptsReturn="True" FontFamily="Cascadia Code,Consolas,monospace"
                                 FontSize="11" MinHeight="90" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Watermark="{loc:Loc 'theme.css.placeholder'}" TextWrapping="NoWrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="{loc:Loc 'theme.css.apply'}" Command="{Binding ApplyCustomCssCommand}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" Padding="14,5"/>
                            <Button Content="{loc:Loc 'theme.css.clear'}" Command="{Binding ClearCustomCssCommand}" Classes="small"/>
                            <TextBlock Text="{loc:Loc 'theme.css.active'}" Foreground="#81c784" FontSize="11"
                                       VerticalAlignment="Center" IsVisible="{Binding HasActiveCustomCss}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Theme preset export/import (save/share the current look) -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <Button Content="📤 Export theme" Command="{Binding ExportThemePresetCommand}" Classes="small"/>
                    <Button Content="📥 Import theme" Command="{Binding ImportThemePresetCommand}" Classes="small"/>
                </StackPanel>
            </StackPanel>

            <!-- System info -->
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="10,8" Margin="0,4">
                <StackPanel Spacing="4">
                    <TextBlock Text="💻 System" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SystemInfoDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Java -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc 'settings.java'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <WrapPanel>
                    <Button Content="{loc:Loc 'common.refresh'}" Command="{Binding DetectJavaCommand}" HorizontalAlignment="Left"/>
                    <Button Content="{loc:Loc 'settings.install_java'}" Command="{Binding InstallJavaRuntimeCommand}"
                            IsEnabled="{Binding !IsInstallingJava}" Background="{DynamicResource AccentBrush}" Foreground="White" Padding="14,5" Margin="8,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding JavaInstallStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="11"
                           IsVisible="{Binding JavaInstallStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <ItemsControl ItemsSource="{Binding JavaRuntimes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelBrush}" Padding="10,6" Margin="0,2" CornerRadius="4">
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                    <Run Text="{Binding MajorVersion}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding BinDirectory}"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Update check -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc 'settings.check_update'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc 'settings.check_update'}" Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding !IsCheckingUpdate}" Classes="small"/>
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <!-- Clickable release link (visible only when an update URL is set) -->
                <Button Content="🔗 Open release page" Click="OpenUpdateUrl_Click" Classes="small"
                        IsVisible="{Binding HasUpdateUrl}" Margin="0,4,0,0"/>
                <!-- Download the update binary directly when the release ships an asset -->
                <Button Content="⬇️ Download update" Command="{Binding DownloadUpdateCommand}" Classes="small"
                        IsVisible="{Binding HasUpdateAsset}" Margin="0,4,0,0"/>
                <!-- Startup auto-check toggle -->
                <CheckBox Content="Check for updates on startup" IsChecked="{Binding CheckForUpdatesOnStartup}"
                          Margin="0,6,0,0"/>
            </StackPanel>

            <!-- CurseForge API key (enables CurseForge mod search/browse) -->
            <StackPanel Spacing="8">
                <TextBlock Text="CurseForge" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                    Enter a CurseForge API key (from the curseforge.com developer console) to search and install CurseForge mods.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding CurseForgeApiKey}" MinWidth="320" Watermark="$2a$10$... API key"/>
                    <Button Content="Save" Command="{Binding SaveCurseForgeKeyCommand}" Classes="small"/>
                    <TextBlock Text="{Binding HasCurseForgeKey, StringFormat='key set: {0}'}"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="Restart the launcher after saving to apply the key to the mod browser."
                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"/>
            </StackPanel>

            <!-- World auto-backup (HMCL-style: backs up worlds periodically while a game runs + on exit) -->
            <StackPanel Spacing="8">
                <TextBlock Text="World Auto-Backup" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox Content="Auto-backup worlds while a game is running" IsChecked="{Binding AutoBackupWorlds}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AutoBackupWorlds}">
                    <TextBlock Text="Every" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AutoBackupIntervalMinutes}" MinWidth="60"/>
                    <TextBlock Text="minutes · Keep" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AutoBackupKeepCount}" MinWidth="60"/>
                    <TextBlock Text="backups per instance" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- AI -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc 'settings.ai'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="{loc:Loc 'settings.detect_local'}" Command="{Binding DetectLocalModelsCommand}" HorizontalAlignment="Left"/>
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelBrush}" Padding="10,8" Margin="0,2" CornerRadius="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Model}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Loc 'settings.activate'}" Classes="small"
                                            Command="{Binding #Root.DataContext.ActivateCommand}" CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add cloud provider -->
                <Border Background="{DynamicResource SurfaceAltBrush}" Padding="12" CornerRadius="4" Margin="0,8,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc 'settings.add_cloud_provider'}" Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding NewProviderName}" Watermark="{loc:Loc 'settings.provider_name'}" MinWidth="120"/>
                            <TextBox Text="{Binding NewProviderModel}" Watermark="{loc:Loc 'settings.provider_model'}" MinWidth="140"/>
                        </StackPanel>
                        <TextBox Text="{Binding NewProviderUrl}" Watermark="{loc:Loc 'settings.provider_url'}" MinWidth="400"/>
                        <TextBox Text="{Binding NewProviderKey}" Watermark="{loc:Loc 'settings.provider_key'}" MinWidth="400" PasswordChar="•"/>
                        <Button Content="{loc:Loc 'settings.add'}" Command="{Binding AddCloudProviderCommand}" Background="#4caf50" Foreground="White" Padding="14,4" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button.small"><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
    </UserControl.Styles>
</UserControl>
