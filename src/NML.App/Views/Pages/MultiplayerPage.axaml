<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.MultiplayerPage">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="760">

            <!-- Header -->
            <StackPanel Spacing="2">
                <TextBlock Text="{loc:Loc 'server.title'}" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc 'server.subtitle'}" Foreground="#888" FontSize="12"/>
            </StackPanel>

            <!-- Add server -->
            <Border Background="#1f1f25" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding NewServerName}" Watermark="{loc:Loc 'server.name'}" MinWidth="160"/>
                        <TextBox Text="{Binding NewServerAddress}" Watermark="{loc:Loc 'server.address'}" MinWidth="260"/>
                        <Button Content="{loc:Loc 'server.add'}" Command="{Binding AddCommand}"
                                IsEnabled="{Binding CanAdd}" Background="#2f5fcc" Foreground="White" Padding="14,6"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc 'server.address_hint'}" Foreground="#666" FontSize="11" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Loc 'server.ping_all'}" Command="{Binding PingAllCommand}"
                        IsEnabled="{Binding !IsPingingAll}" Background="#388e3c" Foreground="White" Padding="14,6"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPingingAll}" Width="120" Height="4"/>
                <TextBlock Text="{Binding Status, StringFormat='{loc:Loc}'}" Foreground="#888" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Export/import server list -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{loc:Loc 'server.export'}" Command="{Binding ExportServersCommand}"
                        Background="#2f5fcc" Foreground="White" Padding="12,5" FontSize="11"/>
                <TextBox Text="{Binding ImportServersPath}" Watermark="{loc:Loc 'server.import_placeholder'}"
                         MinWidth="260" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
                <Button Content="{loc:Loc 'server.import'}" Command="{Binding ImportServersCommand}"
                        Background="#388e3c" Foreground="White" Padding="12,5" FontSize="11"/>
            </StackPanel>

            <!-- Server list -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1a1a20" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                PointerPressed="Row_PointerPressed">
                            <Grid ColumnDefinitions="48,*,Auto">
                                <!-- Favicon / status dot -->
                                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                    <Image Source="{Binding FaviconUrl}" Width="40" Height="40"
                                           IsVisible="{Binding FaviconUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <Border Background="#444" CornerRadius="4" Width="40" Height="40"
                                            IsVisible="{Binding FaviconUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    <!-- Online indicator dot -->
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                            Background="#4caf50" IsVisible="{Binding IsOnline}"/>
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                            Background="#f44336" IsVisible="{Binding !IsOnline}"/>
                                </Grid>

                                <!-- Name + MOTD -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding Entry.Name}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Motd}" Foreground="#aaa" FontSize="11"
                                               TextWrapping="NoWrap" MaxLines="2"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding PlayerCount}" Foreground="#4fc3f7" FontSize="11"/>
                                        <TextBlock Text="{Binding VersionName}" Foreground="#888" FontSize="11"/>
                                        <TextBlock Text="{Binding LatencyText}" Foreground="#888" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Per-row actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText, StringFormat='{loc:Loc}'}"
                                               Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Background="#1a1a20" CornerRadius="6" Padding="20" IsVisible="{Binding Rows.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                <TextBlock Text="{loc:Loc 'server.empty'}" Foreground="#666" FontSize="13" HorizontalAlignment="Center"/>
            </Border>

            <!-- Selected-row actions -->
            <Border Background="#1f1f25" CornerRadius="8" Padding="14,12" IsVisible="{Binding HasSelection}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SelectedRow.Entry.Host, StringFormat='{loc:Loc}'}"
                               Foreground="#4fc3f7" FontSize="12"/>
                    <WrapPanel>
                        <Button Content="⬆" Command="{Binding MoveUpCommand}" Margin="0,0,6,0" ToolTip.Tip="{loc:Loc 'server.move_up'}"/>
                        <Button Content="⬇" Command="{Binding MoveDownCommand}" Margin="0,0,6,0" ToolTip.Tip="{loc:Loc 'server.move_down'}"/>
                        <Button Content="{loc:Loc 'server.ping'}" Command="{Binding PingSelectedCommand}" Margin="0,0,6,0"/>
                        <Button Content="{loc:Loc 'server.connect'}" Command="{Binding ConnectCommand}"
                                Background="#4caf50" Foreground="White" Padding="14,6" Margin="0,0,6,0"/>
                        <Button Content="{loc:Loc 'server.qr.button'}" Command="{Binding ShareQrCodeCommand}"
                                Background="#ab47bc" Foreground="White" Padding="14,6" Margin="0,0,6,0"/>
                        <Button Content="{loc:Loc 'server.remove'}" Command="{Binding RemoveCommand}"
                                Background="#c62828" Foreground="White" Padding="14,6"/>
                    </WrapPanel>
                    <!-- QR-shareable URI + scannable QR image (visible after Share QR is clicked) -->
                    <Border Background="#1a1a20" CornerRadius="4" Padding="10" IsVisible="{Binding ShowQrCode}" Margin="0,4,0,0">
                        <StackPanel Spacing="6">
                            <Image Source="{Binding QrBitmap}" Width="200" Height="200" HorizontalAlignment="Left"
                                   IsVisible="{Binding QrBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <TextBlock Text="{loc:Loc 'server.qr.label'}" Foreground="#4fc3f7" FontSize="11"/>
                            <SelectableTextBlock Text="{Binding QrCodeUri}" Foreground="#ccc" FontFamily="Cascadia Code,Consolas,monospace"
                                                 FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
