<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NML.App.Localization"
             x:Class="NML.App.Views.Pages.HomePage">
    <ScrollViewer Padding="24">
        <Grid>
        <StackPanel Spacing="18" MaxWidth="640">
            <TextBlock Text="{loc:Loc 'home.instances'}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>

            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                     MinHeight="100" MaxHeight="240" Background="#1f1f25" Foreground="#e0e0e0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                            <TextBlock Text="{Binding VersionId}" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Per-instance actions + batch operations -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="➕ New" Command="{Binding OpenNewInstanceWizardCommand}" Classes="small"/>
                <Button Content="📋 Clone" Command="{Binding CloneInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small"
                        IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="📦 Export" Command="{Binding ExportInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small"
                        IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="🗑 Remove" Command="{Binding RemoveInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small danger"
                        IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="{loc:Loc 'home.export_all'}" Command="{Binding ExportAllInstancesCommand}" Classes="small"/>
                <Button Content="{loc:Loc 'home.delete_all'}" Command="{Binding DeleteAllInstancesCommand}" Classes="small"/>
            </StackPanel>

            <!-- Share code -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="🔗 Share" Command="{Binding ShareInstanceCommand}" CommandParameter="{Binding SelectedInstance}" Classes="small"
                            IsEnabled="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBox Text="{Binding ShareCode}" Watermark="NML#..." MinWidth="300" FontFamily="Cascadia Code,Consolas,monospace" FontSize="11" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="📥 Import code" Command="{Binding ImportFromShareCodeCommand}" CommandParameter="{Binding ShareCode}" Classes="small"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc 'home.offline_username'}" Foreground="#ccc" FontSize="13"/>
                <TextBox Text="{Binding OfflineUsername}" MinWidth="240"/>
            </StackPanel>

            <!-- Memory allocation slider -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc 'home.memory'}" Foreground="#ccc" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedMaxMemory}" Foreground="#4fc3f7" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="MB" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <Slider Minimum="512" Maximum="{Binding SliderMax}" Value="{Binding SelectedMaxMemory}"
                        TickFrequency="512" IsSnapToTickEnabled="True" MinWidth="400"/>
                <TextBlock Text="{loc:Loc 'home.memory_recommended'}" Foreground="#888" FontSize="11"/>
            </StackPanel>

            <!-- Advanced launch options -->
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc 'home.advanced'}" Foreground="#ccc" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc 'home.window_size'}" Foreground="#aaa" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SelectedWindowWidth}" MinWidth="60" FontSize="11"/>
                    <TextBlock Text="×" Foreground="#888" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SelectedWindowHeight}" MinWidth="60" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc 'home.jvm_args'}" Foreground="#aaa" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding CustomJvmArgs}" Watermark="-XX:+UseG1GC -Dfml.ignoreInvalidMinecraftCertificates=true" MinWidth="400" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
                    <Button Content="{loc:Loc 'home.auto_tune'}" Command="{Binding ApplyJvmTuningCommand}" Classes="small" ToolTip.Tip="{loc:Loc 'home.auto_tune_hint'}"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc 'home.game_args'}" Foreground="#aaa" FontSize="11"/>
                <TextBox Text="{Binding CustomGameArgs}" Watermark="--fullscreen" MinWidth="500" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"/>
            </StackPanel>

            <Button Content="{loc:Loc 'home.launch'}" Command="{Binding LaunchCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    FontSize="15" FontWeight="Bold" Background="#4caf50" Foreground="White"
                    HorizontalAlignment="Stretch" Padding="0,14"/>

            <!-- Live game console -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                <TextBlock Text="{loc:Loc 'home.console'}" Foreground="#4fc3f7" FontSize="13" FontWeight="SemiBold"/>
                <Border Background="#1a1a1e" CornerRadius="4" Padding="8" MaxHeight="300">
                    <ScrollViewer>
                        <SelectableTextBlock Text="{Binding ConsoleOutput}" Foreground="#c0c0c0"
                                             FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                             TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- New Instance Wizard Dialog -->
        <Border IsVisible="{Binding ShowNewInstanceWizard}" Background="#00000099"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="40">
            <Border Background="#1f1f25" CornerRadius="12" Padding="32" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="➕ New Instance" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Instance name" Foreground="#ccc" FontSize="13"/>
                        <TextBox Text="{Binding NewInstanceName}" MinWidth="360"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Minecraft version (e.g. 1.20.1)" Foreground="#ccc" FontSize="13"/>
                        <TextBox Text="{Binding NewInstanceVersion}" MinWidth="360"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Modloader" Foreground="#ccc" FontSize="13"/>
                        <ComboBox ItemsSource="{Binding ModloaderChoices}" SelectedItem="{Binding NewInstanceModloader}" MinWidth="360"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Memory (MB)" Foreground="#ccc" FontSize="13"/>
                        <Slider Minimum="1024" Maximum="32768" Value="{Binding NewInstanceMemory}"
                                TickFrequency="512" IsSnapToTickEnabled="True" MinWidth="360"/>
                        <TextBlock Text="{Binding NewInstanceMemory}" Foreground="#4fc3f7" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding CancelNewInstanceWizardCommand}" Classes="small"/>
                        <Button Content="Create &amp; Install" Command="{Binding CreateNewInstanceCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Background="#4caf50" Foreground="White" Padding="16,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
