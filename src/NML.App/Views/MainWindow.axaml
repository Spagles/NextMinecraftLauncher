<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:NML.App.Localization"
        xmlns:vm="using:NML.App.ViewModels"
        xmlns:v="using:NML.App.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="NML.App.Views.MainWindow"
        x:Name="Shell"
        Title="Next Minecraft Launcher"
        Width="1100" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding WindowFlowDirection}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent">

    <Window.Resources>
        <!-- Enables the "selected nav item" visual: returns "nav active" when the current
             item equals the shell's CurrentPage, otherwise "nav". Bound to Button.Classes. -->
        <v:NavActiveClassConverter x:Key="NavActiveConverter"/>
        <!-- NavHoverBrush / NavActiveBrush are variant-scoped in App.axaml (light + dark palettes)
             so the nav rail recolors with the theme. NavActiveHoverBrush is a shared accent tint. -->
        <SolidColorBrush x:Key="NavActiveHoverBrush" Color="#4D4FC3F7"/>
    </Window.Resources>

    <!-- Outer grid: background image layer + main content -->
    <Grid>
    <!-- Background image layer (PCL-style, behind everything) -->
    <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill"
           IsVisible="{Binding HasBackground}" Opacity="0.35"/>

    <!-- Custom title bar (PCL-style) -->
    <Grid RowDefinitions="Auto,*" Background="{x:Null}">
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Height="40"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'app.title'}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Content="—" Width="36" Height="28" Classes="titleBtn"/>
                    <Button Click="Maximize_Click" Content="▢" Width="36" Height="28" Classes="titleBtn"/>
                    <Button Click="Close_Click" Content="✕" Width="36" Height="28" Classes="titleBtnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HMCL-style layout: narrow icon-only nav rail + wide content area -->
        <Grid Grid.Row="1" ColumnDefinitions="56,*">

            <!-- Icon-only sidebar (nav rail) -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pages}" Padding="0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Icon button: no text label, just the emoji; tooltip carries the title.
                                     `nav` is a static class for the base style; `active` is toggled by the
                                     NavActiveConverter (CurrentPage equality) for the selected highlight. -->
                                <Button Classes="nav" CornerRadius="8"
                                        Width="40" Height="40"
                                        Padding="0" Margin="0,3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Command="{Binding #Shell.DataContext.NavigateToCommand}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding TitleKey}"
                                        ToolTip.Tip="{Binding LocalizedTitle}">
                                    <Classes.active>
                                        <MultiBinding Converter="{StaticResource NavActiveConverter}">
                                            <Binding Path="DataContext.CurrentPage" ElementName="Shell"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </Classes.active>
                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Content area: the active page view is rendered here via ViewLocator -->
            <DockPanel Grid.Column="1" Background="{DynamicResource PanelAltBrush}">
                <!-- Page header (HMCL shows the current section title at the top of the content) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAltBrush}" Padding="24,14">
                    <TextBlock Text="{Binding CurrentPage.LocalizedTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <!-- The page itself (with slide transition between pages) -->
                <TransitioningContentControl Content="{Binding CurrentPage}" Margin="0">
                    <TransitioningContentControl.PageTransition>
                        <PageSlide Duration="0:0:0.2" Orientation="Horizontal" SlideOutEasing="CubicEaseIn" SlideInEasing="CubicEaseOut"/>
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </DockPanel>
        </Grid> <!-- end sidebar+content grid -->
    </Grid> <!-- end title bar + content grid -->
    </Grid> <!-- end outer grid (background + content) -->

    <Window.Styles>
        <!-- HMCL-style icon nav button base -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- Subtle hover -->
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <!-- Selected item: semi-transparent accent fill + white icon -->
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveHoverBrush}"/>
        </Style>
        <!-- Custom title-bar button styles (PCL-style window controls) -->
        <Style Selector="Button.titleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.titleBtnClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtnClose:pointerover">
            <Setter Property="Background" Value="#e81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <v:ViewLocator/>
    </Window.DataTemplates>
</Window>
