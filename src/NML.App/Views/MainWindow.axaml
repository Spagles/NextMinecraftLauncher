<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:NML.App.Localization"
        xmlns:vm="using:NML.App.ViewModels"
        xmlns:v="using:NML.App.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="NML.App.Views.MainWindow"
        x:Name="Shell"
        Title="Next Minecraft Launcher"
        Width="1100" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <v:ViewLocator/>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1a1a1e">
            <DockPanel>
                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="20,18,20,14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="🎮" FontSize="22"/>
                        <TextBlock Text="{loc:Loc 'app.title'}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{loc:Loc 'app.subtitle'}" FontSize="10" Foreground="#4fc3f7"/>
                    </StackPanel>
                </Border>

                <!-- Nav buttons -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Pages}" Padding="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="nav"
                                        Command="{Binding #Shell.DataContext.NavigateToCommand}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding TitleKey}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Icon}" FontSize="15" Width="20"/>
                                        <TextBlock Text="{Binding LocalizedTitle}" Classes="navLabel"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content area: the active page view is rendered here via ViewLocator -->
        <DockPanel Grid.Column="1" Background="#25252b">
            <!-- Page header -->
            <Border DockPanel.Dock="Top" Background="#2d2d33" Padding="24,14">
                <TextBlock Text="{Binding CurrentPage.LocalizedTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <!-- The page itself -->
            <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
        </DockPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33333b"/>
        </Style>
        <Style Selector="Button.nav TextBlock.navLabel">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Note: full localization of sidebar labels requires a {Loc} binding in the
             DataTemplate; for the MVP the label binds to the raw key and the header re-resolves
             via {Loc}. A later pass can wire per-item localization. -->
    </Window.Styles>
</Window>
