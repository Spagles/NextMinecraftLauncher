<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:NML.App.Localization"
        xmlns:vm="using:NML.App.ViewModels"
        xmlns:v="using:NML.App.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="NML.App.Views.MainWindow"
        x:Name="Shell"
        Title="Next Minecraft Launcher"
        Width="1100" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <!-- Outer grid: background image layer + main content -->
    <Grid>
    <!-- Background image layer (PCL-style, behind everything) -->
    <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill"
           IsVisible="{Binding HasBackground}" Opacity="0.35"/>

    <!-- Custom title bar (PCL-style) -->
    <Grid RowDefinitions="Auto,*" Background="{x:Null}">
        <Border x:Name="TitleBar" Grid.Row="0" Background="#0a0a0e" Height="40"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'app.title'}" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Content="—" Width="36" Height="28" Classes="titleBtn"/>
                    <Button Click="Maximize_Click" Content="▢" Width="36" Height="28" Classes="titleBtn"/>
                    <Button Click="Close_Click" Content="✕" Width="36" Height="28" Classes="titleBtnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#1a1a1e">
            <DockPanel>
                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="20,18,20,14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="🎮" FontSize="22"/>
                        <TextBlock Text="{loc:Loc 'app.title'}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{loc:Loc 'app.subtitle'}" FontSize="10" Foreground="#4fc3f7"/>
                    </StackPanel>
                </Border>

                <!-- Nav buttons -->
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Pages}" Padding="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="nav"
                                        Command="{Binding #Shell.DataContext.NavigateToCommand}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding TitleKey}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Icon}" FontSize="15" Width="20"/>
                                        <TextBlock Text="{Binding LocalizedTitle}" Classes="navLabel"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content area: the active page view is rendered here via ViewLocator -->
        <DockPanel Grid.Column="1" Background="#25252b">
            <!-- Page header -->
            <Border DockPanel.Dock="Top" Background="#2d2d33" Padding="24,14">
                <TextBlock Text="{Binding CurrentPage.LocalizedTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <!-- The page itself (with slide transition between pages) -->
            <TransitioningContentControl Content="{Binding CurrentPage}" Margin="0">
                <TransitioningContentControl.PageTransition>
                    <PageSlide Duration="0:0:0.2" Orientation="Horizontal" SlideOutEasing="CubicEaseIn" SlideInEasing="CubicEaseOut"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </DockPanel>
        </Grid> <!-- end sidebar+content grid -->
    </Grid> <!-- end title bar + content grid -->
    </Grid> <!-- end outer grid (background + content) -->

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33333b"/>
        </Style>
        <Style Selector="Button.nav TextBlock.navLabel">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Custom title-bar button styles (PCL-style window controls) -->
        <Style Selector="Button.titleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtn:pointerover">
            <Setter Property="Background" Value="#33333b"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.titleBtnClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.titleBtnClose:pointerover">
            <Setter Property="Background" Value="#e81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Note: full localization of sidebar labels requires a {Loc} binding in the
             DataTemplate; for the MVP the label binds to the raw key and the header re-resolves
             via {Loc}. A later pass can wire per-item localization. -->
    </Window.Styles>

    <Window.DataTemplates>
        <v:ViewLocator/>
    </Window.DataTemplates>
</Window>
